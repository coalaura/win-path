{
	"name": "win-path",
	"displayName": "Windows Path",
	"description": "Escape windows path backslashes automatically on paste.",
	"version": "1.0.2",
	"author": "coalaura",
	"publisher": "coalaura",
	"icon": "logo.png",
	"galleryBanner": {
		"color": "#051049",
		"theme": "dark"
	},
	"license": "SEE LICENSE IN LICENSE",
	"keywords": [
		"paste",
		"path",
		"windows",
		"backslash"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/coalaura/win-path"
	},
	"engines": {
		"vscode": "^1.77.0"
	},
	"categories": [
		"Snippets",
		"Other"
	],
	"activationEvents": [
		"onWillChangeTextDocument",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": {
			"title": "Windows Path",
			"properties": {
				"win-path.quotesOnly": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Only replace backslashes when surrounded by quotes."
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint .",
		"package": "npm run build && vsce package",
		"build": "node esbuild.config.js",
		"watch": "node esbuild.config.js --watch"
	},
	"devDependencies": {
		"@types/glob": "^9.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.3.3",
		"@types/vscode": "^1.109.0",
		"esbuild": "^0.27.3",
		"esbuild-copy-static-files": "^0.1.0",
		"eslint": "^10.0.2",
		"glob": "^13.0.6",
		"mocha": "^11.7.5",
		"typescript": "^5.9.3"
	}
}